GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MONGODB_URI=mongodb://127.0.0.1:27017/agrisphere
# Feature: Historical Market Data & Price Trend Charts — a SECOND,
# independent MongoDB connection (never mixed with MONGODB_URI above)
# pointed at a database that already contains historical mandi price
# records. Optional: if unset, the last-7-days historical trend chart
# just shows "no historical data available" instead of failing.
MONGO_URI2=mongodb://127.0.0.1:27017/agrisphere_historical
# Name of the collection inside that database holding the historical
# records, if it isn't called "mandi_prices".
HISTORICAL_COLLECTION_NAME=mandi_prices
PORT=5000
DATA_GOV_API_KEY=your_data_gov_api_key_here
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODE_USER_AGENT=AgriSphereAI/1.0 (contact: your-email@example.com)
# Phase 2: how often (ms) the background job re-polls every tracked crop
# to keep growing real price history. Defaults to 24h if unset.
HISTORY_POLL_INTERVAL_MS=86400000
# Phase 5: secret used to sign login sessions. MUST be set to a long
# random value in any real deployment — see authService.js for the
# (obviously-insecure) dev fallback used if this is left unset.
JWT_SECRET=replace_this_with_a_long_random_string